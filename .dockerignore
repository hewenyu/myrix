# Myrix container build context.
#
# The images never inherit the working tree's installs or state: dependencies
# are reinstalled inside the image from the frozen lockfiles, and the web bundle
# is rebuilt. Everything excluded here is either reproducible, private, or the
# read-only upstream submodule baseline.
#
# Do NOT ignore: sources, lockfiles, tests/poc/lib + probes (the Cell profile
# factory), bundles/, apps/cell-manager/**, LICENSE, NOTICE.

# --- VCS, CI, editor --------------------------------------------------------
.git
.gitmodules
.github
.team
.idea
.vscode
.DS_Store

# --- installs are reproduced inside the image from pnpm-lock.yaml -----------
# Any depth: root, per-workspace-project, and tests/poc/.dsh-install/node_modules.
**/node_modules

# --- generated output and caches (rebuilt per target architecture) ----------
**/dist
**/build
**/coverage
**/.vite
**/.vite-temp
**/*.tsbuildinfo

# --- runtime state, private config and secrets ------------------------------
# data/ holds local runtime state and Cell homes; .env holds secrets.
data
**/.env
**/.env.*
!**/.env.example
**/secrets
**/.ssh
**/.aws
**/*.pem
**/*.key
**/.dsh
**/.dsh-home
**/.pnpm-store
**/.cache
# Compose initialization creates private files that Git ignores; Docker does not
# read .gitignore, so explicitly exclude every generated deployment location.
deploy/auth/generated
deploy/vps/auth
deploy/vps/*.env
deploy/vps/sql/*.sql
**/*.dump
**/*.sql.gz
**/backups
**/*.tgz
**/*.tar.gz

# --- PoC / test working state ----------------------------------------------
# tests/poc/.work* is regenerated by run-poc.mjs / run-cell.mjs.
**/.work
**/.work-*
**/.plugins

# --- logs -------------------------------------------------------------------
**/*.log
**/logs

# --- upstream source baseline ----------------------------------------------
# vendor/deepseek-harness is a read-only submodule and is not runnable. The
# Cell image runs the locked npm install from tests/poc/.dsh-install, whose
# @deepseek-ai/dsh package ships its own MIT LICENSE, preserved untouched.
vendor
