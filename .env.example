# Copy to .env (ignored by Git); chmod 600 .env. Only the model gateway receives this key.
# The gateway takes the FULL Responses endpoint, not just the /v1 base URL.
# This project forbids chat/completions, including compatibility routes and fallback.
MYRIX_GATEWAY_UPSTREAM_URL=https://api.example.com/v1/responses
MYRIX_GATEWAY_UPSTREAM_MODEL=your-responses-model
# Replace both placeholders with your own verified Responses endpoint and exact model id.
# A model alias alone does not establish its underlying version; no protocol fallback.
MYRIX_GATEWAY_UPSTREAM_API_KEY=
# Conservative operational context limit; do not exceed the chosen model's documented context capacity.
MYRIX_MODEL_CONTEXT_WINDOW=65536
# Provisioning runs separately. Do not put the migration URL into any service/Cell environment.
# MYRIX_MIGRATE_DATABASE_URL=postgres://myrix_migrator:myrix_local_migrator@127.0.0.1:55439/myrix
