{
  "name": "myrix",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Myrix —— 基于 DeepSeek Harness 的企业私有化 Agent 平台",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "submodule:init": "git submodule update --init --recursive vendor/deepseek-harness",
    "submodule:status": "git submodule status vendor/deepseek-harness",
    "submodule:unshallow": "git -C vendor/deepseek-harness fetch --unshallow --tags",
    "submodule:sync": "git submodule update --remote vendor/deepseek-harness",
    "lint": "oxlint packages plugins apps scripts tests *.ts && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:ci": "node --test tests/ci/*.test.mjs tests/containers/*.test.mjs tests/vps/*.test.mjs tests/auth-deploy/*.test.mjs tests/poc/tests/factory.test.mjs",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @myrix/novel-web typecheck",
    "test": "vitest run && pnpm --filter @myrix/novel-web test",
    "build:web": "pnpm --filter @myrix/novel-web build",
    "test:browser": "node tests/acceptance/local-browser.mjs",
    "test:watch": "vitest",
    "setup:dev": "tsx apps/bff/scripts/setup-dev.ts",
    "dev": "tsx apps/bff/scripts/start-dev.ts",
    "dev:legacy": "tsx packages/control-plane/src/bin.ts",
    "console": "tsx packages/control-plane/src/bin.ts",
    "render:profile": "tsx scripts/render-profile.ts",
    "demo:decide": "tsx scripts/demo-decide.ts"
  },
  "devDependencies": {
    "@myrix/control-plane": "workspace:*",
    "@myrix/registry": "workspace:*",
    "@types/node": "^26.6.3",
    "esbuild": "0.28.2",
    "oxc-parser": "0.152.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
