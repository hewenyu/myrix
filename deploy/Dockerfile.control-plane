# 控制面的开发/演示镜像。
# 注意：当前直接以 tsx 运行 TypeScript 源码，便于 M0 阶段快速迭代；
# 生产镜像应在 CI 中先 tsc 构建（或 tsdown 打包）再拷贝 dist。
FROM node:22-alpine

WORKDIR /app
RUN corepack enable

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages ./packages
COPY plugins ./plugins
COPY apps ./apps
COPY scripts ./scripts
COPY tsconfig.json vitest.config.ts ./

RUN pnpm install --frozen-lockfile

ENV PORT=8787 HOST=0.0.0.0
EXPOSE 8787
CMD ["pnpm", "exec", "tsx", "packages/control-plane/src/bin.ts"]
