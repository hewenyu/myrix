{
  "name": "@myrix/platform-store",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Myrix 持久业务存储：Postgres + Kysely，typed schema、租户 RLS、CAS 版本、持久命令队列与 outbox/audit",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:pg": "vitest run --config vitest.config.ts",
    "migrate": "tsx src/bin/migrate.ts",
    "seed:dev": "tsx src/bin/seed.ts"
  },
  "dependencies": {
    "@myrix/governance": "workspace:*",
    "kysely": "^0.28.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
