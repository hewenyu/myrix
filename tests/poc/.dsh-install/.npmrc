# Keep this install hoisted, exactly like a real deployment image: the DSH
# profile resolver walks the installation's dependency graph, and a nested
# pnpm layout makes `@deepseek-ai/dsh-*` lookups depend on the virtual store.
node-linker=hoisted
auto-install-peers=true
# The PoC pins one exact prerelease; ranges would silently move the runtime.
save-exact=true
